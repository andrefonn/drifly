<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FF6900">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#D9202430"
                android:centerColor="#B8171923"
                android:endColor="#D911131B" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1.5dp"
                android:color="#4DFF6900" />
        </shape>
    </item>
</ripple>
