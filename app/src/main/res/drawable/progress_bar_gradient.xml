<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fundo rebaixado escuro estilo cockpit financeiro -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#111319"
                android:endColor="#181B24" />
            <stroke
                android:width="1dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>
    <!-- Barra de preenchimento vibrante com gradiente laranja e brilho suave -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="10dp" />
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="#FF9F2E"
                    android:centerColor="#FF6900"
                    android:endColor="#FF5000" />
            </shape>
        </clip>
    </item>
</layer-list>
