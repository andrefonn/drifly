<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/drifly_orange_tint" />
            <corners android:radius="11dp" />
            <stroke
                android:width="1dp"
                android:color="@color/drifly_orange" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/drifly_field" />
            <corners android:radius="11dp" />
            <stroke
                android:width="1dp"
                android:color="@color/drifly_line" />
        </shape>
    </item>
</selector>
