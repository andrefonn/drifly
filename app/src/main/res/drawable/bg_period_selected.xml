<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FF6900">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#E61C1F2B"
                android:centerColor="#D9161922"
                android:endColor="#E611131B" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.8dp"
                android:color="#FF6900" />
        </shape>
    </item>
</ripple>
