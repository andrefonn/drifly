<resources>
    <style name="Theme.DriFly" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Tipografia Premium Plus Jakarta Sans -->
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>

        <!-- Cores Primárias do Branding -->
        <item name="colorPrimary">#FF6900</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#FF8A24</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        
        <item name="colorSurface">#12151B</item>
        <item name="colorOnSurface">#F5F5F7</item>
        <item name="colorSurfaceVariant">#1E212A</item>
        
        <item name="android:statusBarColor">#0B0D11</item>
        <item name="android:navigationBarColor">#0B0D11</item>
        <item name="android:windowBackground">#0B0D11</item>

        <!-- Custom Indicator for BottomNavigationView -->
        <item name="bottomNavigationStyle">@style/Widget.DriFly.BottomNavigationView</item>
    </style>

    <style name="Widget.DriFly.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.DriFly.BottomNavIndicator</item>
        <item name="itemRippleColor">#20FF6900</item>
    </style>

    <style name="Widget.DriFly.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/bottom_nav_indicator_color</item>
        <item name="android:width">72dp</item>
        <item name="android:height">44dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.DriFly.Pill</item>
    </style>

    <style name="ShapeAppearance.DriFly.Pill" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">24dp</item>
    </style>
</resources>
