<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="@drawable/bg_light_dialog">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lançar Nova Despesa"
        android:textColor="@color/drifly_ink"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textStyle="bold"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Informe a categoria e o valor para abater do lucro líquido real."
        android:textColor="@color/drifly_mut"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Categoria"
        android:textColor="@color/drifly_ink"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textStyle="bold"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etExpenseCategory"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_light_field"
        android:paddingHorizontal="14dp"
        android:hint="Ex: Gasolina, Almoço, Troca de Óleo"
        android:textColorHint="#606B7B"
        android:textColor="@color/drifly_ink"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textSize="14sp"
        android:inputType="textCapWords" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Valor (R$)"
        android:textColor="@color/drifly_ink"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textStyle="bold"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etExpenseAmount"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_light_field"
        android:paddingHorizontal="14dp"
        android:hint="0,00"
        android:textColorHint="#606B7B"
        android:textColor="@color/drifly_ink"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textStyle="bold"
        android:textSize="16sp"
        android:inputType="numberDecimal"
        android:digits="0123456789,." />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Observação (Opcional)"
        android:textColor="@color/drifly_ink"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textStyle="bold"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etExpenseDesc"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_light_field"
        android:paddingHorizontal="14dp"
        android:hint="Ex: Posto Shell Centro"
        android:textColorHint="#606B7B"
        android:textColor="@color/drifly_ink"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textSize="14sp"
        android:inputType="text" />

    <!-- Abastecimento: alimenta o tanque da bolinha flutuante -->
    <LinearLayout
        android:id="@+id/layoutFuelFill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_light_info"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Foi abastecimento?"
                    android:textColor="@color/drifly_ink"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvFuelFillHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Soma litros na bolinha do tanque"
                    android:textColor="@color/drifly_mut"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/swFuelFill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutFuelLiters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Litros abastecidos"
                    android:textColor="@color/drifly_ink"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvFuelLitersHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Calculado pelo preço do litro"
                    android:textColor="@color/drifly_mut"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="122dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_light_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <EditText
                    android:id="@+id/etFuelLiters"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:padding="0dp"
                    android:hint="0,00"
                    android:textColor="@color/drifly_ink"
                    android:textColorHint="@color/drifly_mut"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:gravity="end"
                    android:inputType="numberDecimal"
                    android:digits="0123456789,." />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="L"
                    android:textColor="@color/drifly_mut"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Botões de Ação Embutidos no Card de Vidro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelExpense"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            app:backgroundTint="@null"
            android:background="@drawable/bg_light_chip"
            android:textColor="@color/drifly_mut"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textStyle="bold"
            android:textSize="14sp"
            android:text="Cancelar" />

        <Button
            android:id="@+id/btnSaveExpense"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.3"
            android:layout_marginStart="12dp"
            app:backgroundTint="@null"
            android:background="@drawable/bg_btn_primary_gradient"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textStyle="bold"
            android:textSize="14sp"
            android:text="Salvar Despesa" />
    </LinearLayout>

</LinearLayout>
