<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_glass">

    <!-- Cabeçalho do Relatório com Ícone de Calendário -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_calendar_orange"
            android:contentDescription="Relatório" />

        <TextView
            android:id="@+id/tvReportTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Histórico Unificado"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textStyle="bold"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/btnDialogReportCloseIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_btn_circle_glass"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#A3A8B5"
            android:contentDescription="Fechar" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Resumo consolidado de faturamento, despesas e lucro real."
        android:textColor="#A3A8B5"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textSize="12sp" />

    <!-- Barra de Chips de Período (Navegação Rápida no Modal) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnReportChipToday"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            android:background="@drawable/bg_period_selected"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textStyle="bold"
            android:textSize="11sp"
            android:text="Hoje" />

        <Button
            android:id="@+id/btnReportChipWeek"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.2"
            android:layout_marginStart="5dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            android:background="@drawable/bg_period_unselected"
            android:textColor="#A3A8B5"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textStyle="bold"
            android:textSize="11sp"
            android:text="Semana" />

        <Button
            android:id="@+id/btnReportChipMonth"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            android:background="@drawable/bg_period_unselected"
            android:textColor="#A3A8B5"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textStyle="bold"
            android:textSize="11sp"
            android:text="Mês" />

        <Button
            android:id="@+id/btnReportChipYear"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            android:background="@drawable/bg_period_unselected"
            android:textColor="#A3A8B5"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textStyle="bold"
            android:textSize="11sp"
            android:text="Ano" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#1AFFFFFF" />

    <!-- Card de Métricas Consolidado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_inner_metric_card"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Linha 1: Corridas Analisadas e KM Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Corridas Analisadas:"
                android:textColor="#A3A8B5"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReportRideCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Linha 2: Faturamento Bruto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Faturamento Bruto:"
                android:textColor="#A3A8B5"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReportGross"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Linha 3: Total de Despesas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total de Despesas:"
                android:textColor="#A3A8B5"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReportExpenses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textColor="#FF454D"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Linha 4: Distância Total & Média R$/km -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvReportKmLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Distância Total:"
                android:textColor="#A3A8B5"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReportKm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 km"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Card de Destaque: Lucro Líquido Real -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_btn_circle_glass"
        android:padding="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LUCRO LÍQUIDO REAL"
                android:textColor="#FF8A24"
                android:fontFamily="@font/plus_jakarta_sans"
                android:letterSpacing="0.05"
                android:textStyle="bold"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvReportNet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="R$ 0,00"
                android:textColor="#31D477"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textStyle="bold"
                android:textSize="20sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_metric_profit_up"
            android:contentDescription="Lucro" />
    </LinearLayout>

    <!-- Seção de Lista de Corridas Detalhada -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Corridas Detalhadas"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvReportRidesBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toque para gerenciar"
            android:textColor="#A3A8B5"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="220dp"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/layoutReportRidesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReportNoRides"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="16dp"
                android:gravity="center"
                android:text="Nenhuma corrida registrada neste período."
                android:textColor="#707684"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutReportRidesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- Botão Fechar Estilizado -->
    <Button
        android:id="@+id/btnReportClose"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        app:backgroundTint="@null"
        android:background="@drawable/bg_period_unselected"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textStyle="bold"
        android:textSize="13sp"
        android:text="Fechar" />

</LinearLayout>
