<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_glass">

    <!-- Topo: Título e Detalhes da Corrida -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_circle_glass"
            android:padding="8dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_nav_rides"
                app:tint="#FF6900"
                android:contentDescription="Editar Corrida" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAdjustRideTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajuste Rápido de Corrida"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textStyle="bold"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvAdjustRideSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uber • R$ 32,50 • 8,4 km"
                android:textColor="#A3A8B5"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Status Atual -->
        <TextView
            android:id="@+id/tvAdjustCurrentBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESTIMADO"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_badge_pill"
            android:textColor="#FFB800"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textStyle="bold"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="#1AFFFFFF" />

    <!-- Campo: Ajustar Valor Real Recebido -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Valor Real Recebido (R$):"
        android:textColor="#A3A8B5"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textStyle="bold"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etAdjustRealPrice"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:textColor="#FFFFFF"
            android:textColorHint="#5A6072"
            android:fontFamily="@font/plus_jakarta_sans"
            android:inputType="numberDecimal"
            android:digits="0123456789,."
            android:paddingHorizontal="14dp"
            android:textSize="15sp"
            android:hint="0,00" />

        <Button
            android:id="@+id/btnSaveAdjustedPrice"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            app:backgroundTint="@null"
            android:background="@drawable/bg_btn_primary_gradient"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textStyle="bold"
            android:textSize="12sp"
            android:text="Salvar Valor" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ações Rápidas de Status:"
        android:textColor="#A3A8B5"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textStyle="bold"
        android:textSize="12sp" />

    <!-- Ação 1: Marcar como Concluída -->
    <Button
        android:id="@+id/btnActionMarkCompleted"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        app:backgroundTint="@null"
        android:background="@drawable/bg_btn_secondary_glass"
        android:textColor="#31D477"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textStyle="bold"
        android:textSize="13sp"
        android:text="✓  Confirmar como Concluída" />

    <!-- Ação 2: Marcar como Cancelada COM TAXA -->
    <Button
        android:id="@+id/btnActionCancelWithFee"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        app:backgroundTint="@null"
        android:background="@drawable/bg_btn_secondary_glass"
        android:textColor="#60A5FA"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textStyle="bold"
        android:textSize="13sp"
        android:text="⚡  Cancelada com Taxa (Padrão)" />

    <!-- Ação 3: Marcar como Cancelada SEM TAXA -->
    <Button
        android:id="@+id/btnActionCancelZeroFee"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        app:backgroundTint="@null"
        android:background="@drawable/bg_btn_secondary_glass"
        android:textColor="#FF454D"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textStyle="bold"
        android:textSize="13sp"
        android:text="✕  Cancelada sem Taxa (R$ 0,00)" />

    <!-- Ação 4: Excluir Corrida -->
    <Button
        android:id="@+id/btnActionDeleteRide"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        app:backgroundTint="@null"
        android:background="@drawable/bg_period_unselected"
        android:textColor="#A3A8B5"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textSize="12sp"
        android:text="🗑  Excluir Corrida do Extrato" />

    <!-- Botão Fechar -->
    <Button
        android:id="@+id/btnAdjustClose"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        app:backgroundTint="@null"
        android:background="@drawable/bg_card_frosted_glass"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textStyle="bold"
        android:textSize="13sp"
        android:text="Voltar ao Extrato" />

</LinearLayout>
